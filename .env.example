# The easy way to make your settings is to run:  python3 -m planespotter setup
# Or copy this file to .env and fill it in by hand. .env is git-ignored, so
# your address and password never end up on GitHub.

# --- Where to watch -----------------------------------------------------------
# Right-click your house in Google Maps and click the coordinates to copy them.
HOME_LAT=51.5007
HOME_LON=-0.1246
HOME_NAME=Home

# How close a plane has to come to count, in miles.
RADIUS_MILES=3

# Optional: ignore anything flying higher than this (e.g. 10000 for low
# flyers only). Leave blank to include airliners cruising at 35,000 ft.
MAX_ALTITUDE_FT=

# --- Quiet hours ---------------------------------------------------------------
# No alert emails during these hours; those planes go in the morning report.
# Use 24-hour times (22:00-07:00) or am/pm (10pm-7am). Blank = alerts any time.
QUIET_HOURS=22:00-07:00

# --- Email ---------------------------------------------------------------------
# For Gmail: turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste it below.
# Leave these blank to test without sending: emails get saved to outbox/.
EMAIL_TO=
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Daily digest --------------------------------------------------------------
DIGEST_TIME=07:00
# IANA time zone name, e.g. America/New_York. Blank = this computer's zone.
TIMEZONE=

# --- Live map ------------------------------------------------------------------
# `watch` also serves a live 3D/2D map at http://localhost:8765
MAP_ENABLED=true
MAP_PORT=8765
# true = phones/tablets on the same Wi-Fi can open the map too; false = this computer only
MAP_LAN=true
# Look up the complete flight (takeoff to landing) of each plane that crosses your zone
WHOLE_FLIGHTS=true
# Also serve the map over https (on MAP_PORT + 1), which phones need for the sky view (AR),
# the share sheet and the microphone. planespotter makes its own certificate with openssl.
MAP_HTTPS=true
# MAP_HTTPS_PORT=8766
# Check the clouds at the nearest airport (aviationweather.gov) so alerts and the map can say
# when a plane will be hidden above them
WEATHER=true

# --- adsb.lol (where the flight data comes from) -------------------------------
# Free, but limited per day: 500 requests without a key (planespotter then checks
# for planes about every 4 minutes), 1,000 with a free key (every 2 minutes) from
# https://www.adsb.lol/request, 7,200 if you feed adsb.lol from your own receiver.
ADSB_API_KEY=
# Only needed if your limit isn't the usual one for your key (feeders: 7200).
ADSB_DAILY_LIMIT=

# --- Phone notifications (ntfy) --------------------------------------------------
# Install the free ntfy app and subscribe to this topic. Setup makes a random one;
# anyone who knows the name can read it, so keep it to yourself.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=          (only for your own private ntfy server)

# --- Special planes ----------------------------------------------------------------
# Alerts for emergencies (7700/7600/7500), military aircraft, rare types, helicopters
# over your zone, and "firsts" (an airline or aircraft type you've never spotted).
SPECIAL_ALERTS=true
SPECIAL_HELICOPTERS=true
# Which aircraft types count as special (ICAO type codes, comma separated):
# SPECIAL_TYPES=A388,B744,B748,A124,A225,BLCF,A3ST,A337,C5M,B52,CONC

# --- Weekly email -------------------------------------------------------------------
WEEKLY_REPORT=true
WEEKLY_DAY=sun

# --- Your own ADS-B receiver ----------------------------------------------------------
# The address of its aircraft.json for unlimited, real-time data (blank = adsb.lol only),
# e.g. http://adsb-feeder.local:8080/data/aircraft.json
RECEIVER_URL=

# --- Tuning (the defaults are fine) --------------------------------------------
# The fastest planespotter will check for planes, in seconds (minimum 10). It
# checks less often than this when needed to stay within adsb.lol's daily limit.
POLL_SECONDS=20
# Safety valve: stop emailing alerts after this many in an hour (planes still
# show up in the digest). Handy if you live under a flight path.
MAX_ALERTS_PER_HOUR=12
# Set to false for digest-only, or to stop the digest.
ALERTS_ENABLED=true
DIGEST_ENABLED=true
